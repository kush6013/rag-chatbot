* {
    box-sizing: border-box;
}

body {
    margin: 0;

    font-family: Arial, Helvetica, sans-serif;

    background: #f5f5f5;
}

.app {
    width: 100%;
    max-width: 1000px;

    height: 100vh;

    margin: 0 auto;

    display: flex;
    flex-direction: column;

    background: white;
}


/* Header */

.header {
    padding: 20px;

    display: flex;
    justify-content: space-between;
    align-items: center;

    border-bottom: 1px solid #ddd;
}

.header h1 {
    margin: 0;
}

.header p {
    margin: 5px 0 0;

    color: #666;
}

button {
    border: none;

    padding: 10px 16px;

    border-radius: 8px;

    cursor: pointer;

    font-size: 14px;
}

#clearButton {
    background: #eee;
}


/* Chat */

.chat-container {
    flex: 1;

    overflow-y: auto;

    padding: 20px;
}

.welcome-message {
    text-align: center;

    margin-top: 100px;

    color: #555;
}

.message {
    display: flex;

    margin-bottom: 15px;
}

.message.user {
    justify-content: flex-end;
}

.message.ai {
    justify-content: flex-start;
}

.message-content {
    max-width: 75%;

    padding: 12px 16px;

    border-radius: 12px;

    line-height: 1.5;
}

.user .message-content {
    background: #222;

    color: white;
}

.ai .message-content {
    background: #eee;

    color: #222;
}


/* Sources */

.sources {
    margin-top: 10px;

    padding-top: 8px;

    border-top: 1px solid #ccc;

    font-size: 12px;
}

.source {
    margin-top: 4px;
}


/* Upload */

.upload-section {
    padding: 12px 20px;

    border-top: 1px solid #ddd;
}

.upload-section label {
    cursor: pointer;

    font-weight: bold;
}

#pdfInput {
    margin-left: 10px;
}

#uploadStatus {
    margin-left: 10px;

    color: #666;
}


/* Input */

.input-section {
    display: flex;

    gap: 10px;

    padding: 15px 20px;

    border-top: 1px solid #ddd;
}

#messageInput {
    flex: 1;

    resize: none;

    padding: 12px;

    border: 1px solid #ccc;

    border-radius: 8px;

    font-size: 15px;
}

#sendButton {
    background: #222;

    color: white;

    min-width: 80px;
}

#sendButton:disabled {
    opacity: 0.5;

    cursor: not-allowed;
}


/* Loading */

.loading {
    opacity: 0.6;

    font-style: italic;
}
